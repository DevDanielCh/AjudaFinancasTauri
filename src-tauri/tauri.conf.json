{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ajuda Finanças",
  "mainBinaryName": "ajudafinancas",
  "version": "0.1.7",
  "identifier": "com.ajudafinancas.app",
  "build": {
    "beforeDevCommand": "bun run dev -- -H 0.0.0.0",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Ajuda Finanças",
        "width": 1400,
        "height": 918,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2MEM3NDNFODMyMTJBREYKUldUZktpR0RQblFNZGdPajJWd290aXFrNDJSeVlESE9tS3JlYS9ZcGlNb1dBdDNXSEhUK3ZTSU4K",
      "endpoints": [
        "https://github.com/DevDanielCh/AjudaFinancasTauri/releases/latest/download/latest.json"
      ]
    }
  }
}
